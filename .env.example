# ==============================================================================
# AgriShield AI — Platform Environment Variables
# ==============================================================================

# Application
PROJECT_NAME="AgriShield AI"
VERSION="1.0.0"
ENVIRONMENT="production"  # development | staging | production

# Security
SECRET_KEY="replace-with-a-cryptographically-secure-random-token-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# Database (PostgreSQL with PostGIS Extension)
# Local Docker Compose format:
DATABASE_URL="postgresql+psycopg2://postgres:postgres@db:5432/agrishield_db"
# Azure Database for PostgreSQL flexible server format:
# DATABASE_URL="postgresql+psycopg2://agriadmin:YourStrongPassword@agrishield-postgres.postgres.database.azure.com:5432/agrishield_db?sslmode=require"

# Background Broker (Redis)
REDIS_URL="redis://redis:6379/0"

# External APIs
OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1"

# CORS Allowed Origins (Comma separated or JSON array)
BACKEND_CORS_ORIGINS='["http://localhost:5173", "http://localhost:3000", "https://*.azurestaticapps.net"]'

# Machine Learning
ML_MODEL_DIR="./backend/app/ml/saved_models"

# Azure Cloud Architecture Integration
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_STORAGE_CONTAINER_NAME="agrishield-reports-media"
APPLICATIONINSIGHTS_CONNECTION_STRING=""
